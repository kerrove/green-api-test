{
	"name": "green-api-test",
	"version": "0.1.0",
	"private": true,
	"author": {
		"name": "Kirill Vegele",
		"email": "kirove.work@gmail.com",
		"url": "https://kerrove.ru"
	},
	"engines": {
		"bun": "^1.2"
	},
	"scripts": {
		"prebuild": "rimraf .next",
		"dev": "next dev -H 0.0.0.0 -p 80",
		"dev-local": "next dev --turbopack -H 0.0.0.0 -p 80",
		"build": "next build",
		"start": "next start",
		"prod": "next build && next start -H 0.0.0.0 -p 80",
		"lint": "eslint",
		"test": "jest",
		"test:watch": "jest --watchAll",
		"test:e2e-watch": "bunx playwright test --ui --ui-port=8080 --ui-host=0.0.0.0",
		"test:e2e": "bunx playwright test",
		"check": "knip --config ./knip.json",
		"format": "prettier --write \"src/**/*.{ts,tsx}\""
	},
	"dependencies": {
		"@tanstack/react-query": "^5.104.1",
		"axios": "^1.20.0",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.23",
		"framer-motion": "^14.0.0",
		"jose": "^6.2.12",
		"js-cookie": "^3.0.8",
		"lucide-react": "^1.52.0",
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hook-form": "^7.89.0",
		"react-hot-toast": "^2.6.1",
		"rimraf": "^6.1.3",
		"sharp": "^0.35.5",
		"tailwind-merge": "^3.7.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@tailwindcss/turbopack": "^4",
		"@tanstack/react-query-devtools": "^5.104.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/bun": "^1.4.2",
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "1.0.0",
		"depcheck": "^1.4.7",
		"dotenv": "^18.0.6",
		"eslint": "^9",
		"eslint-config-next": "16.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"jiti": "^2.7.0",
		"knip": "^6.40.0",
		"prettier": "^3.9.9",
		"sass": "^1.105.1",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"packageManager": "bun@1.3.8",
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}
